# ============================================================
# StudyBot 后端环境变量模板
# 使用方式: 复制此文件为 .env，修改需要的值
#   cp .env.example .env
# ============================================================

# --- 应用 ---
APP_NAME=StudyBot
APP_ENV=development
APP_DEBUG=true

# --- 数据库 (PostgreSQL + pgvector) ---
# 连接串格式: postgresql+asyncpg://用户:密码@主机:端口/数据库
# asyncpg 是 Python 异步 PostgreSQL 驱动，配合 SQLAlchemy async 使用
# 主机名 postgres = docker-compose 中 postgres 服务的容器名
DATABASE_URL=postgresql+asyncpg://studybot:studybot123@postgres:5432/studybot

# --- Redis ---
# 用于: 缓存、JWT 黑名单、限流、Celery Result Backend
# 主机名 redis = docker-compose 中 redis 服务的容器名
REDIS_URL=redis://redis:6379/0

# --- RabbitMQ ---
# 用于: Celery Broker (消息队列)
# 格式: pyamqp://用户:密码@主机:端口/vhost
# 主机名 rabbitmq = docker-compose 中 rabbitmq 服务的容器名
RABBITMQ_URL=pyamqp://guest:guest@rabbitmq:5672//

# --- JWT ---
# 密钥: 生产环境用复杂随机字符串，开发环境可简单
# 生成方式: openssl rand -hex 32
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM (OpenAI 兼容) ---
# 可换成 Ollama / Groq 等兼容接口的 URL
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini              # 用于 Router（意图分类）
LLM_MODEL_PREMIUM=gpt-4o           # 用于 Agent（计划生成、问答）
EMBEDDING_MODEL=text-embedding-3-small

# --- Celery ---
CELERY_BROKER_URL=pyamqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1
